{
    "name": "descvoice",
    "private": true,
    "version": "1.0.1",
    "type": "module",
    "main": "electron/main.js",
    "scripts": {
        "dev": "vite",
        "electron": "electron .",
        "desktop": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
        "build": "vite build",
        "lint": "oxlint",
        "preview": "vite preview",
        "dist": "npm run build && electron-builder"
    },
    "dependencies": {
        "i18next": "^26.5.11",
        "lucide-react": "^1.61.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-i18next": "^17.1.9"
    },
    "devDependencies": {
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "concurrently": "^10.0.6",
        "electron": "^44.9.2",
        "electron-builder": "^26.15.3",
        "oxlint": "^1.88.0",
        "vite": "^8.3.4",
        "wait-on": "^9.5.1"
    },
    "build": {
        "appId": "ru.descvoice.app",
        "productName": "DescVoice",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "electron/**/*",
            "package.json"
        ],
        "extraResources": [
            {
                "from": "backend.exe",
                "to": "backend.exe"
            },
            {
                "from": "recognize.exe",
                "to": "recognize.exe"
            },
            {
                "from": "speak.exe",
                "to": "speak.exe"
            },
            {
                "from": "public/icon.ico",
                "to": "icon.ico"
            }
        ],
        "win": {
            "icon": "public/icon.ico",
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ]
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true
        }
    }
}